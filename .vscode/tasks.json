{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Browser Request: Prepare Current Ticket",
      "type": "shell",
      "command": "node scripts/tasks/browser-request-watcher.js file \"${file}\" --open-prompt --force",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Browser Request: Prepare And Claim Current Ticket",
      "type": "shell",
      "command": "node scripts/tasks/browser-request-watcher.js file \"${file}\" --open-prompt --claim --force",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Browser Request: Watch Pending Tickets",
      "type": "shell",
      "command": "npm run browser:watch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
