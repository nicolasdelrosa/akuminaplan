# Copy this file to .env and set values before starting the server.
BRIDGE_PORT=8787
BRIDGE_HOST=0.0.0.0
BRIDGE_TOKEN=replace-with-a-strong-random-token
BRIDGE_REQUEST_TTL_MS=120000
BRIDGE_LOG_DIR=runtime-logs
BRIDGE_ALLOWED_CLIENT_IPS=
BRIDGE_REQUIRE_TAILSCALE=false
BRIDGE_MAX_ACTIVE_CONNECTIONS=5
BRIDGE_MAX_PAYLOAD_BYTES=65536
BRIDGE_MAX_PROMPT_CHARS=4000
